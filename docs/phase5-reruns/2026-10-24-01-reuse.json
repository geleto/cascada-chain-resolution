  "registryCheckSource": "import fs from 'node:fs';\nimport { SAFEGUARDS } from 'file:///C:/Projects/cascada-chain-resolution/test/safeguards/registry.mjs';\nconst saved=JSON.parse(fs.readFileSync('docs/phase5-sensitivity.json','utf8')).safeguardCatalog;\nlet anchors=0; const repeatedAnchors=[];\nfor(const entry of SAFEGUARDS){\n const prior=saved[entry.id];\n if(!prior || JSON.stringify(entry.faults)!==JSON.stringify(prior.faultEdits) || JSON.stringify(entry.witnesses)!==JSON.stringify(prior.declaredWitnessSelectors))throw Error(entry.id+' registry differs');\n const sources=new Map();\n for(const [index,fault] of entry.faults.entries()){\n  let text=sources.get(fault.file)??fs.readFileSync(fault.file,'utf8').replace(/\\r\\n/g,'\\n');\n  const matches=text.split(fault.find).length-1;\n  if(!matches)throw Error(entry.id+' missing fault '+index);\n  if(matches>1)repeatedAnchors.push({id:entry.id,index,matches,selection:'first exact match, as fault-hook.mjs specifies'});\n  sources.set(fault.file,text.replace(fault.find,fault.replace));anchors++;\n }\n}\nconsole.log(JSON.stringify({entries:SAFEGUARDS.length,anchors,allCurrent:true,repeatedAnchors}));\n",
